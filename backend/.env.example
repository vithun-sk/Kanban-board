# FlowSync Backend Environment Variables
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/flowsync?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=your_minimum_256_bit_secure_random_hex_or_string_key
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DEV_SEED_ENABLED=true
